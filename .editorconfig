# One source of truth for whitespace, honoured by every major editor without a
# plugin. Cheap insurance against a mixed-indentation diff.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,java}]
indent_size = 4

[*.{cpp,hpp,h,c}]
indent_size = 4

[*.{tf,tfvars,hcl}]
indent_size = 2

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
