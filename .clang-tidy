# Static analysis, not formatting.
#
# There is deliberately no .clang-format here. This codebase uses compact guard
# clauses, and clang-format cannot express them — AllowShortBlocksOnASingleLine
# only preserves SINGLE-statement blocks, so enforcing it would expand every
# guard in the project. The one shape that IS a hazard — `if (x) return;` with a
# second statement on the same line — is caught by -Wmisleading-indentation in
# the build, which is the right tool for it.
#
# WarningsAsErrors is deliberately NARROWER than Checks: the error set is the
# checks that find DEFECTS (lifetime, data races, null derefs). The rest run as
# warnings so they inform without blocking on a matter of taste.
#
# Disabled checks and why (they cannot be commented inline — Checks is a YAML
# block scalar, so a '#' inside it becomes part of the string):
#
#   bugprone-branch-clone
#     Argument parsers and command dispatchers have structurally similar
#     branches by nature. `else if (k == "--x") a.x = next();` repeated per flag
#     is the clearest way to write one, not duplication to factor out.
#
#   bugprone-throwing-static-initialization
#     The test framework registers each case with a static object, so every test
#     is "an initialization with static storage duration that may throw". That
#     is the framework's design, not a defect in these files.
#
#   bugprone-empty-catch
#     Fires on `catch (const std::exception& e) { std::printf(...); }`, which is
#     not empty. Kept out of the error set rather than restructuring correct code
#     to satisfy a misfire.
#
#   misc-use-anonymous-namespace
#     `static` at file scope in a benchmark is correct and conventional C.
#
#   cert-err34-c / cert-err58-cpp
#     atoi in an argv parser that has already validated its input, and static
#     objects that may throw — both covered above.
Checks: >
  bugprone-*,
  cert-*,
  concurrency-*,
  performance-*,
  portability-*,
  readability-*,
  clang-analyzer-*,
  misc-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  -bugprone-throwing-static-initialization,
  -bugprone-empty-catch,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-implicit-bool-conversion,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-use-anonymous-namespace,
  -cert-err58-cpp,
  -cert-err34-c

WarningsAsErrors: 'bugprone-*,concurrency-*,clang-analyzer-*'

HeaderFilterRegex: '(include|src)/.*\.(hpp|h)$'

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
